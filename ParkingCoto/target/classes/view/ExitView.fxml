<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ExitViewController">
	<VBox spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
		<Label text="Vehicle Exit" />
		<TextField fx:id="ticketIdField" promptText="Ticket ID" />
		<Button mnemonicParsing="false" onAction="#findTicket" text="Find Ticket" />
		<Label fx:id="ticketDetailsLabel" />
		<Label fx:id="messageLabel" />
	</VBox>
</AnchorPane>
