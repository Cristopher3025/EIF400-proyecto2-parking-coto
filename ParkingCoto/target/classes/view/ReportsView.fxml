<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReportsViewController">
	<VBox spacing="14.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
		<Label text="Reports" />
		<GridPane hgap="20.0" vgap="12.0">
			<Label text="Total spaces" GridPane.columnIndex="0" GridPane.rowIndex="0" />
			<Label fx:id="totalSpacesLabel" GridPane.columnIndex="1" GridPane.rowIndex="0" />
			<Label text="Available spaces" GridPane.columnIndex="0" GridPane.rowIndex="1" />
			<Label fx:id="availableSpacesLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
			<Label text="Occupied spaces" GridPane.columnIndex="0" GridPane.rowIndex="2" />
			<Label fx:id="occupiedSpacesLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" />
			<Label text="Total revenue" GridPane.columnIndex="0" GridPane.rowIndex="3" />
			<Label fx:id="revenueLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" />
		</GridPane>
		<Button mnemonicParsing="false" onAction="#refresh" text="Refresh" />
	</VBox>
</AnchorPane>
