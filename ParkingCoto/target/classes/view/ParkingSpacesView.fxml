<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="800.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ParkingSpacesViewController">
	<VBox spacing="12.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
		<Label text="Parking Spaces" />
		<TableView fx:id="parkingSpacesTable" VBox.vgrow="ALWAYS">
			<columns>
				<TableColumn fx:id="numberColumn" prefWidth="220.0" text="Number" />
				<TableColumn fx:id="typeColumn" prefWidth="220.0" text="Type" />
				<TableColumn fx:id="statusColumn" prefWidth="220.0" text="Status" />
			</columns>
		</TableView>
		<Button mnemonicParsing="false" onAction="#refresh" text="Refresh" />
	</VBox>
</AnchorPane>
