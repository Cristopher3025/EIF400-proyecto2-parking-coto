<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXTextField?>
<?import io.github.palexdev.materialfx.controls.MFXComboBox?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
    id="AnchorPane"
    fx:id="AP_PARKING_SPACES"
    prefHeight="540.0"
    prefWidth="946.0"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.ParkingSpacesViewController">

    <children>

        <!-- ================================================= -->
        <!-- REGISTRATION AREA                                 -->
        <!-- ================================================= -->

        <AnchorPane
            prefHeight="540.0"
            prefWidth="367.0">

            <children>

                <Label
                    layoutX="109.0"
                    layoutY="105.0"
                    prefHeight="58.0"
                    prefWidth="152.0"
                    text="Registrar espacio">

                    <font>
                        <Font
                            name="Trebuchet MS"
                            size="18.0" />
                    </font>

                </Label>

                <Label
                    layoutX="95.0"
                    layoutY="210.0"
                    prefHeight="25.0"
                    prefWidth="77.0"
                    text="Número">

                    <font>
                        <Font size="11.0" />
                    </font>

                </Label>

                <MFXTextField
                    fx:id="TF_NUMBER"
                    layoutX="94.0"
                    layoutY="222.0"
                    opacity="0.98"
                    prefHeight="48.0"
                    prefWidth="181.0"
                    promptText="Ej. A-01" />

                <MFXComboBox
                    fx:id="CB_TYPE_VEHICLE"
                    layoutX="95.0"
                    layoutY="316.0"
                    prefHeight="48.0"
                    prefWidth="181.0"
                    promptText="Seleccione el tipo de vehículo" />

                <JFXButton
                    fx:id="BTN_REGISTER"
                    layoutX="127.0"
                    layoutY="435.0"
                    onAction="#RegisterSpace"
                    prefHeight="48.0"
                    prefWidth="116.0"
                    text="Registrar" />

            </children>

        </AnchorPane>

        <!-- ================================================= -->
        <!-- REGISTERED PARKING SPACES                         -->
        <!-- ================================================= -->

        <AnchorPane
            layoutX="367.0"
            prefHeight="540.0"
            prefWidth="578.0">

            <children>

                <Label
                    layoutX="199.0"
                    layoutY="14.0"
                    prefHeight="58.0"
                    prefWidth="181.0"
                    text="Espacios registrados">

                    <font>
                        <Font
                            name="Trebuchet MS"
                            size="18.0" />
                    </font>

                </Label>

                <!-- SEARCH -->

                <ImageView
                    fitHeight="31.0"
                    fitWidth="30.0"
                    layoutX="14.0"
                    layoutY="72.0"
                    pickOnBounds="true"
                    preserveRatio="true">

                    <image>
                        <Image
                            url="@../images/3844432-magnifier-search-zoom_110300.png" />
                    </image>

                </ImageView>

                <JFXTextField
                    fx:id="TF_SEARCH_SPACES"
                    layoutX="54.0"
                    layoutY="72.0"
                    prefHeight="25.0"
                    prefWidth="472.0"
                    promptText="Buscar por id, tipo, estado o vehículo..." />

                <!-- ACTION BUTTONS -->

                <JFXButton
                    fx:id="BTN_OUT_OF_SERVICE"
                    layoutX="245.0"
                    layoutY="108.0"
                    prefHeight="35.0"
                    prefWidth="145.0"
                    text="Fuera de servicio"
                    onAction="#MarkOutOfService" />

                <JFXButton
                    fx:id="BTN_RESTORE_SERVICE"
                    layoutX="400.0"
                    layoutY="108.0"
                    prefHeight="35.0"
                    prefWidth="145.0"
                    text="Habilitar espacio"
                    onAction="#RestoreService" />

                <!-- TABLE -->

                <TableView
                    fx:id="TV_PARKING_SPACES"
                    layoutY="153.0"
                    prefHeight="387.0"
                    prefWidth="578.0">

                    <columns>

                        <TableColumn
                            fx:id="TV_RW_ID"
                            prefWidth="159.0"
                            text="Número" />

                        <TableColumn
                            fx:id="TV_RW_TYPE_VEHICLE"
                            prefWidth="145.0"
                            text="Tipo" />

                        <TableColumn
                            fx:id="TV_RW_VEHICLE"
                            prefWidth="118.0"
                            text="Vehículo" />

                        <TableColumn
                            fx:id="TV_RW_STATE"
                            minWidth="5.0"
                            prefWidth="155.0"
                            text="Estado" />

                    </columns>

                </TableView>

            </children>

        </AnchorPane>

    </children>

</AnchorPane>